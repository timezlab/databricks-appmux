{
  "name": "appmux-ui",
  "version": "0.0.0",
  "private": true,
  "description": "appmux admin UI: a Next.js static export served by the appmux edge (ADR 0012).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project dom",
    "test:export": "vitest run --project export",
    "test:e2e": "playwright test",
    "e2e:screenshots": "node e2e/screenshots.ts",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "next": "16.4.2",
    "radix-ui": "1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "node-releases": "2.0.59",
    "electron-to-chromium": "1.5.456",
    "es-toolkit": "1.53.0"
  }
}
